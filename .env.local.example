# URL pública del sitio — usada para canonical URLs, hreflang, sitemap y OG.
# Cambia a https://visita.casitascanarias.com (o tu dominio final) cuando migres.
NEXT_PUBLIC_SITE_URL=https://real-canaria.vercel.app

# URL externa de Casitas Canarias para el bloque de cross-sell.
# Déjalo así a menos que Casitas Canarias cambie de dominio.
NEXT_PUBLIC_CASITAS_URL=https://casitascanarias.com

# ID de afiliado Civitatis — lo añade Antonio cuando tenga la cuenta.
# Si está vacío, los links a Civitatis funcionan sin tracking de afiliado.
NEXT_PUBLIC_CIVITATIS_AID=

# Mapbox GL — público (expuesto al cliente). Crear en https://mapbox.com (free tier 50k loads/mes)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Neon PostgreSQL (para V2, cuando conectemos DB real). Crear en https://neon.tech
DATABASE_URL=
